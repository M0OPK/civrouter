BaudRate            19200               # Baud rate to be used on the comm port. It makes sense for ALL comm ports to be the same speed.
TranslateAddress    0xE2                # For good routing, we can masquerade the controller address to be different per port.
                                        # The radio will see us as different controllers and we'll be able to route responses to the
                                        # correct program. Best to use 0xE0-0xEF
RealAddress         0xE0                # The real address (auto detect is flaky)
AcceptTransceive    True                # This port accepts transceive commands, otherwise they will not be sent to this port
SendTransceive      False               # This port is allowed to send transceive commands, otherwise they will be ignored
SendInfoUpdates     True		# When a frequency or mode change is sent from this port, resend as a transceive command to ports supporting transceive
AcceptInfoUpdates   True		# When a frequency or mode change is sent, resend as a transceive command to this port

[VirtualSerial]
PortAddress         "/dev/tnt7"         # This is the serial port file that will be specified in apps connecting to the radio
BaudRate            19200               # Baud rate to be used on the comm port. It makes sense for ALL comm ports to be the same speed.
TranslateAddress    0xE3                # For good routing, we can masquerade the controller address to be different per port.
                                        # The radio will see us as different controllers and we'll be able to route responses to the
                                        # correct program. Best to use 0xE0-0xEF
RealAddress         0xE0                # The real address (auto detect is flaky)
AcceptTransceive    True                # This port accepts transceive commands, otherwise they will not be sent to this port
SendTransceive      False               # This port is allowed to send transceive commands, otherwise they will be ignored
SendInfoUpdates     True		# When a frequency or mode change is sent from this port, resend as a transceive command to ports supporting transceive
AcceptInfoUpdates   True		# When a frequency or mode change is sent, resend as a transceive command to this port

